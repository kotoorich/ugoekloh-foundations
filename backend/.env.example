# Private backend settings. Never expose this file or commit real values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Supabase Dashboard -> Connect -> Session pooler -> URI (use the database password).
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Initial administrator: created automatically on first backend startup.
INITIAL_ADMIN_EMAIL=admin@your-foundation-domain.org
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD_AT_LEAST_12_CHARACTERS
INITIAL_ADMIN_NAME=Foundation Administrator
# Optional: leave empty until Paystack test mode is configured.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5173/donation/return
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
